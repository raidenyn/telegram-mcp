# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session file path (default: ./session)
TELEGRAM_SESSION_PATH=./telegram.session

# Data directory for downloaded files
DATA_DIR=./data

# Transport: stdio or http
TRANSPORT=stdio

# Port for HTTP transport (if used)
PORT=3000

# Bearer token for HTTP transport authentication (required for http)
# Generate with: node -e "console.log(crypto.randomUUID())"
AUTH_TOKEN=
